{
  "name": "equipment-ops-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "dev:paper": "vite --host 127.0.0.1 --port 5175 --strictPort --configLoader native",
    "build": "tsc -b && vite build --configLoader native",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:geospatial-boundaries": "node scripts/check-geospatial-boundaries.mjs",
    "test:geo": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/geoCalibration.test.ts",
    "test:airport-config": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/airportConfigurationIntegration.test.ts",
    "test:network-compiler": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/airportNetworkCompiler.test.ts tests/manualNetworkCalibrationCompiler.test.ts",
    "test:operational-network": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/operationalAirportNetwork.test.ts",
    "test:service-road-connections": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/serviceRoadConnectionDraft.test.ts",
    "test:map-surface": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/candidateNetworkGeoJson.test.ts tests/manualNetworkCalibration.test.ts",
    "test:traffic": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test --test-concurrency=1 tests/groundTraffic.test.ts",
    "test:simulation": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/simulationClock.test.ts tests/simulationScenarioSnapshot.test.ts tests/simulationContract.test.ts tests/simulationDataSimulator.test.ts tests/simulationPlannerConfiguration.test.ts tests/simulationScenarioComparison.test.ts tests/simulationBatchStability.test.ts tests/operationalDisruptionExperiment.test.ts tests/operationalTimeClassification.test.ts tests/simulationPlanValidation.test.ts tests/simulationEndToEndAcceptance.test.ts tests/baselineEventEngine.test.ts tests/resourceConstrainedEventEngine.test.ts tests/simulationExecutionProjection.test.ts tests/threeAirportSimulationResourceAcceptance.test.ts tests/deterministicReplay.test.ts tests/simulationReplayAudit.test.ts tests/simulationInvariants.test.ts tests/simulationTransitionGuard.test.ts",
    "test:paper-replay": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/deterministicReplay.test.ts tests/simulationReplayAudit.test.ts",
    "test:paper-invariants": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/simulationInvariants.test.ts",
    "test:paper-guards": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/simulationTransitionGuard.test.ts",
    "test:paper-disruptions": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs --test tests/operationalDisruptionExperiment.test.ts",
    "experiment:paper-disruptions": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-test-loader.mjs scripts/run-operational-disruption-experiment.mjs",
    "import:airport-snapshot": "node scripts/import-osm-airport-snapshot.mjs",
    "audit:manual-network": "node scripts/audit-manual-network-calibration.mjs",
    "import:service-roads": "node scripts/import-osm-service-roads.mjs",
    "preview": "vite preview --configLoader native"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
